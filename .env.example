# 树莓娘语音输入模块环境变量示例。
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，真实凭据不会进入版本库。
# 全部键名与默认值的权威说明见 README「安装与配置」。

# ── waycast hub（必填）──────────────────────────────────────────────
WAYCAST_HUB_URL="ws://127.0.0.1:8000"
# 核心分配给语音输入模块的连接令牌
WAYCAST_HUB_TOKEN=""
# 可选：waycast 使用私有 TLS 证书时的 CA 证书路径（wss:// 时必填）
# WAYCAST_TLS_CA="/path/to/ca.pem"

# ── ASR（必填；OpenAI 兼容端点，本地 audio.cpp 为 http://127.0.0.1:8080/v1）──
VOICE_IN_ASR_ENDPOINT="http://127.0.0.1:8080/v1"
VOICE_IN_ASR_MODEL="nemotron-3.5-asr-streaming"
# 本地 audio.cpp 无需密钥，留空即可
VOICE_IN_ASR_API_KEY=""

# ── 真流式 ASR（ADR-0005；默认开启，失败自动回退批量转写）────────────
# 设 0 整体关闭流式路径，全部走批量
# VOICE_IN_ASR_LIVE="1"
# 端点后等待流式最终文本的毫秒数（默认 10000，超时按失败回退批量）
# VOICE_IN_ASR_LIVE_TIMEOUT_MS="10000"
# 连续失败多少次后本进程永久关闭流式路径（默认 3，重启恢复）
# VOICE_IN_ASR_LIVE_MAX_FAILURES="3"

# ── 端点检测（默认进程内 Silero VAD ONNX，ADR-0007）───────────────────
# 设 energy 强制使用能量 VAD（默认 silero：随包 ONNX 模型进程内推理；
# 模型缺失或推理连续失败自动落回能量 VAD）
# VOICE_IN_VAD="silero"
# Silero 语音判定概率阈值（默认 0.5；负阈值自动取 −0.15=0.35。调低更灵敏
# 易误触发，调高更保守易漏触发）
# VOICE_IN_VAD_THRESHOLD="0.5"
# 短于此长度的语音段视为噪声丢弃（默认 250）
# VOICE_IN_VAD_MIN_SPEECH_MS="250"

# ── 能量 VAD 参数（Silero 未启用或降级路径使用；括号内为默认值）────────
# 语音判定能量阈值
# VOICE_IN_VAD_SPEECH_THRESHOLD="300"
# 判定一句结束所需的连续静音帧数（20 ms/帧）
# VOICE_IN_VAD_TRAILING_SILENCE_FRAMES="20"
# 单段语音最大帧数
# VOICE_IN_VAD_MAX_FRAMES="1500"
# 语音起始前保留的前摇帧数
# VOICE_IN_VAD_PRE_ROLL_FRAMES="5"

# ── 麦克风（可选）───────────────────────────────────────────────────
# 指定采集设备名称；不填用系统默认输入设备
# VOICE_IN_DEVICE=""

# ── 降噪（GTCRN，ADR-0006；默认开启）────────────────────────────────
# 设 0 关闭进程内 GTCRN 流式降噪，VAD 与 ASR 直接使用原始麦克风音频；
# 模型加载失败或推理连续失败时自动降级/旁路（日志 warning）
# VOICE_IN_DENOISE="1"

# ── 说话人识别（CAM++，ADR-0002/0009）──────────────────────────────
# 复用现有 spk_N 所需的余弦相似度阈值（默认 0.31 = 真实语音工作点；
# 调高更倾向铸新 ID，调低更倾向合并；判定分数见 DEBUG 日志）
# VOICE_IN_SPEAKER_THRESHOLD="0.31"

# ── 调试日志 ────────────────────────────────────────────────────────
# 本模块日志级别（默认 INFO；DEBUG 输出端点检测、ASR 请求/转写结果、说话人判定分数等调试信息）
# VOICE_IN_LOG_LEVEL="INFO"
# 第三方依赖日志级别（默认 WARNING：屏蔽 websockets/httpx/asyncio/onnxruntime）
# VOICE_IN_DEPS_LOG_LEVEL="WARNING"

# ── 端点音频落盘（调试用，可选）─────────────────────────────────────
# 填目录后，每个端点发给 ASR 的音频逐条写为该目录下 WAV（16 kHz 单声道，
# 内容与批量上传逐字节一致，可直接试听开头是否完整）；不设不落盘
# VOICE_IN_DUMP_WAV="/tmp/voice-input-dump"
