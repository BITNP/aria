# 树莓娘语音输入模块环境变量示例。
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，真实凭据不会进入版本库。
# 全部键名与默认值的权威说明见 README「安装与配置」。

# ── waycast hub（必填）──────────────────────────────────────────────
WAYCAST_HUB_URL="ws://127.0.0.1:8000"
# 核心分配给语音输入模块的连接令牌
WAYCAST_HUB_TOKEN=""
# 可选：waycast 使用私有 TLS 证书时的 CA 证书路径（wss:// 时必填）
# WAYCAST_TLS_CA="/path/to/ca.pem"

# ── ASR（必填；OpenAI 兼容端点，本地 audio.cpp 为 http://127.0.0.1:8080/v1）──
VOICE_IN_ASR_ENDPOINT="http://127.0.0.1:8080/v1"
VOICE_IN_ASR_MODEL="nemotron-3.5-asr-streaming"
# 本地 audio.cpp 无需密钥，留空即可
VOICE_IN_ASR_API_KEY=""

# ── 真流式 ASR（ADR-0005；默认开启，失败自动回退批量转写）────────────
# 设 0 整体关闭流式路径，全部走批量
# VOICE_IN_ASR_LIVE="1"
# 端点后等待流式最终文本的毫秒数（默认 10000，超时按失败回退批量）
# VOICE_IN_ASR_LIVE_TIMEOUT_MS="10000"
# 连续失败多少次后本进程永久关闭流式路径（默认 3，重启恢复）
# VOICE_IN_ASR_LIVE_MAX_FAILURES="3"

# ── 端点检测（可选；默认能量 VAD）────────────────────────────────────
# 指向 audio.cpp 服务地址后启用 Silero VAD 端点检测（ADR-0003）；服务连续
# 轮询失败会永久降级回能量 VAD
# VOICE_IN_VAD_URL="http://127.0.0.1:8080"
# VOICE_IN_VAD_MODEL="silero-vad"
# Silero 分段轮询间隔毫秒（默认 300；调到 100 可缩短端点判定延迟）
# VOICE_IN_VAD_POLL_MS="300"
# 短于此长度的分段视为噪声丢弃（默认 250）
# VOICE_IN_VAD_MIN_SPEECH_MS="250"

# ── 能量 VAD 参数（Silero 未启用或降级路径使用；括号内为默认值）────────
# 语音判定能量阈值
# VOICE_IN_VAD_SPEECH_THRESHOLD="300"
# 判定一句结束所需的连续静音帧数（20 ms/帧）
# VOICE_IN_VAD_TRAILING_SILENCE_FRAMES="20"
# 单段语音最大帧数
# VOICE_IN_VAD_MAX_FRAMES="1500"
# 语音起始前保留的前摇帧数
# VOICE_IN_VAD_PRE_ROLL_FRAMES="5"

# ── 麦克风（可选）───────────────────────────────────────────────────
# 指定采集设备名称；不填用系统默认输入设备
# VOICE_IN_DEVICE=""
